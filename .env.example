# =============================================================
# IT4997-BE — Biến môi trường (mẫu)
# Copy file này thành `.env` rồi điền giá trị. KHÔNG commit `.env` thật.
# Lưu ý: dotenv KHÔNG override biến đã set sẵn ngoài shell.
# =============================================================

# ---------- HTTP server ----------
# Cổng HTTP của API (server.ts đọc process.env.PORT, mặc định 4001).
# KHÁC với PORT_DB (cổng MongoDB) bên dưới.
PORT=4001
# Chế độ production: đặt 'true' ở prod để bật secure/sameSite cho cookie (utils isProd()).
PROD=false

# ---------- MongoDB ----------
# (Đây là tên biến ĐÚNG mà connectDB.ts đọc — bản cũ gõ nhầm
#  PORT→PORT_DB, UATH_DATABASE→AUTH_DATABASE, PAS_DB→PASS_DB)
IP_DB=localhost
PORT_DB=27017
DATABASE_NAME=IT-4409
# authSource; bỏ trống sẽ dùng DATABASE_NAME
AUTH_DATABASE=IT-4409
# Bỏ trống nếu MongoDB local không bật auth
USER_DB=
PASS_DB=
REPLICA_SET=rs0

# ---------- JWT / Auth ----------
# BẮT BUỘC đặt ở prod — fallback mặc định ("your-default-secret") KHÔNG an toàn.
# Dùng chuỗi ngẫu nhiên đủ dài (vd: openssl rand -hex 32).
ACCESS_TOKEN_SECRET=change_me_to_a_long_random_string
# Domain cho cookie. Local: để trống. Prod: .yourdomain.com
COOKIE_DOMAIN=

# ---------- URL Frontend ----------
# WEB_URL: dùng dựng success_url / cancel_url của Stripe.
WEB_URL=http://localhost:5000
# FRONTEND_URL: dùng redirect sau đăng nhập Google OAuth. NÊN để trùng WEB_URL.
FRONTEND_URL=http://localhost:5000

# ---------- Stripe ----------
# Local: sk_test_...   |   Prod: sk_live_...
STRIPE_SECRET_KEY=sk_test_xxx
# Local: lấy từ `stripe listen --forward-to localhost:4001/api/payment/webhook`
# Prod : signing secret của webhook endpoint tạo trong Stripe Dashboard
#        (endpoint trỏ tới https://<api-prod>/api/payment/webhook, lắng nghe
#         sự kiện checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Google OAuth (chỉ cần nếu dùng đăng nhập Google) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback

# ---------- Cloudinary (upload ảnh — bắt buộc nếu dùng tính năng upload) ----------
# Code dùng non-null (!) nên thiếu sẽ lỗi khi khởi tạo provider.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Elasticsearch (tìm kiếm sản phẩm) ----------
IP_ELASTIC=localhost
HTTP_ELASTIC=9200
USER_ELASTIC=elastic
PASS_ELASTIC=changeme

# ---------- Redis (hiện connectRedis đang tắt trong server.ts; để sẵn) ----------
REDIS_URL=redis://localhost:6379

# ---------- Rate limit ----------
# Danh sách IP bỏ qua rate limit, ngăn cách bằng dấu phẩy (vd: 127.0.0.1,10.0.0.5)
WHITELISTED_IPS=

# =============================================================
# GHI CHÚ BẢO MẬT (chưa wire vào env — cần refactor nếu muốn dùng)
# - Khóa AES mã hoá token (encryptObject/decryptObject) đang HARDCODE trong
#   src/utils/index.ts (biến SECRET). Ở prod nên sửa code để đọc từ env
#   (vd AES_SECRET) rồi đổi giá trị thật. HIỆN code CHƯA đọc biến này nên
#   đặt vào .env sẽ không có tác dụng cho tới khi refactor.
# =============================================================
